      "tokens-per-accepted-repair",
      "elapsed-time",
      "regressions",
      "integrity-failures",
      "negative-control-unnecessary-change"
    ],
    "confidenceLevel": 0.95,
    "intervalMethod": "seeded repository-clustered paired bootstrap",
    "configurationAggregation": "equal-weight-fixed-requested-set",
    "reportPerConfiguration": true,
    "replacementPolicy": "none"
  }
