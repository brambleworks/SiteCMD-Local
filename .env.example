# SiteCMD local build configuration
#
# Copy this file to .env only when you need the corresponding integration.
# Every value below is optional for the free local workbench. Keep real
# credentials in the ignored .env file or your shell, never in this template.

# Connected service and signed catalog. Release builds set these explicitly.
SITECMD_CONNECTED_ENDPOINT=
SITECMD_ACTIVATION_ENDPOINT=
SITECMD_CATALOG_ENDPOINT=
SITECMD_CATALOG_PUBLIC_KEY=

# LemonSqueezy subscription display and connected-service entitlement.
SITECMD_LICENSE_STORE_ID=
SITECMD_LICENSE_CORE_MONTHLY_VARIANT_ID=
SITECMD_LICENSE_CORE_ANNUAL_VARIANT_ID=
SITECMD_LICENSE_PRO_MONTHLY_VARIANT_ID=
SITECMD_LICENSE_PRO_ANNUAL_VARIANT_ID=
SITECMD_LICENSE_CORE_CHECKOUT_URL=
SITECMD_LICENSE_PRO_CHECKOUT_URL=

# OAuth integrations used by locally built desktop binaries.
# Use both fields from the same Google Desktop client; they are embedded in the app.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=

# Hosted diagnostics destinations for local development builds. Runtime usage
# and crash-report consent remain off until separately confirmed in the app.
VITE_SITECMD_TELEMETRY_ENDPOINT=
VITE_SITECMD_SENTRY_DSN=

# Developer and test overrides.
CORRELATION_V3=
SITECMD_DB_PATH=
SITECMD_ATTACH_DEV_URL=
SITECMD_ATTACH_TIMEOUT_MS=
SITECMD_ATTACH_POLL_MS=
SITECMD_CLI_BINARY=
# Optional native smoke executable override; unset or empty uses the desktop debug binary.
SITECMD_SMOKE_BINARY=
# Optional native smoke MCP bundle override; unset or empty uses the built desktop bundle.
SITECMD_SMOKE_MCP=
# Debug builds only. Set to 1 to keep integration secrets in the plaintext
# dev-secrets.json store instead of the OS keychain. Unset, a debug build uses
# the keychain exactly like a release build, so entries saved to the old
# plaintext file are invisible until re-entered or this variable is set, and an
# unsigned dev build prompts for keychain access on each secret read.
# SITECMD_DEV_PLAINTEXT_SECRETS=1
SITECMD_E2E_PORT=
SITECMD_GUARDRAILS_ROOT=
SITECMD_RUST_AUDIT_FETCH=
# Optional CodeQL fixture checkout override; unset or empty uses this checkout.
SITECMD_CODEQL_ROOT=
# Optional local CodeQL comparison ref override; when unset, uses origin/main.
SITECMD_CODEQL_BASE=
# Optional local CodeQL memory budget in MiB; when unset or empty, uses 4096.
SITECMD_CODEQL_RAM=
SITECMD_SOURCE_COMMIT=
SITECMD_VERBOSE_LOGS=
SITECMD_VERIFY_PUSH=
SITECMD_WEBVIEW_LOGS=
TAURI_DEV_HOST=
VITE_ENABLE_REACT_SCAN=
