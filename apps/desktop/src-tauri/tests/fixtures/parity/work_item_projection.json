    },
    {
      "current": {"seo.title":"low"},
      "expected": {"regressed":["seo.title"]},
      "name": "a_new_check_regresses",
      "prior": {}
    },
    {
      "current": {"seo.title":"low"},
      "expected": {"regressed":null},
      "name": "an_unchanged_or_better_check_does_not",
      "prior": {"seo.title":"medium"}
    },
    {
      "current": {"seo.title":"low"},
      "expected": {"regressed":["seo.title"]},
      "name": "an_unknown_prior_label_counts_as_absent",
      "prior": {"seo.title":"severe"}
    },
    {
      "current": {},
      "expected": {"regressed":null},
      "name": "nothing_current_is_nothing_regressed",
      "prior": {"seo.title":"high"}
