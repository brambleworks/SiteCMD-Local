{
  "name": "sitecmd-mcp",
  "version": "1.4.0",
  "private": true,
  "description": "MCP server for SiteCMD - lets AI coding tools read scan results and fix issues",
  "type": "module",
  "engines": {
    "node": ">=22.22.1"
  },
  "scripts": {
    "build": "tsc && cp src/*.json dist/",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/**/*.ts",
    "test": "pnpm run build && pnpm run bundle && node --test test/*.test.mjs",
    "start": "node dist/index.js",
    "bundle": "node scripts/bundle.mjs",
    "schema:check": "node scripts/check-schema-contract.mjs"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/brambleworks/SiteCMD",
    "directory": "apps/mcp-server"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.4.0",
    "better-sqlite3": "^13.0.3",
    "esbuild": "0.28.2",
    "typescript": "~6.0.3"
  }
}
