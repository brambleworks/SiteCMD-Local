{
  "name": "sitecmd-workspace",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24.19.0 <25",
      "onFail": "error"
    }
  },
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621",
  "bin": {
    "sitecmd": "./tools/scripts/sitecmd.mjs"
  },
  "scripts": {
    "dev": "pnpm --filter @sitecmd/desktop run dev",
    "dev:tauri": "pnpm --filter @sitecmd/desktop run dev:tauri",
    "build": "pnpm run build:all",
    "build:desktop": "pnpm --filter @sitecmd/desktop run build",
    "build:all": "pnpm run build:desktop && pnpm run quality:mcp",
    "lint": "eslint .",
    "preview": "pnpm --filter @sitecmd/desktop run preview",
    "naming:audit": "node ./tools/scripts/audit-frontend-filenames.mjs",
    "perf:baseline": "pnpm --filter @sitecmd/desktop run perf:baseline",
    "benchmark": "node ./tools/benchmark/workflow-benchmark.mjs",
    "benchmark:test": "node --test tools/benchmark/lib/*.test.mjs",
    "benchmark:vm": "node ./tools/benchmark/vm.mjs",
    "benchmark:vm:tools": "node ./tools/benchmark/install-vm-tools.mjs",
    "benchmark:vm:build": "node ./tools/benchmark/build-vm.mjs",
    "benchmark:vm:smoke": "node ./tools/benchmark/smoke-calibration.mjs",
    "benchmark:vm:selftest": "node ./tools/benchmark/selftest-calibration.mjs",
    "benchmark:cases:validate": "node ./tools/benchmark/validate-calibration.mjs",
    "benchmark:cases:scan": "node ./tools/benchmark/scan-calibration.mjs",
    "benchmark:repository:qualify": "node ./tools/benchmark/qualify-repository.mjs",
    "benchmark:repository:prepare": "node ./tools/benchmark/prepare-repository-study.mjs",
    "benchmark:repository:runtime": "node ./tools/benchmark/prepare-repository-runtime.mjs",
    "benchmark:repository:screen": "node ./tools/benchmark/screen-repository-corpus.mjs",
    "benchmark:repository:findings": "node ./tools/benchmark/screen-repository-findings.mjs",
    "benchmark:repository:confirm": "node ./tools/benchmark/qualify-confirmatory-corpus.mjs",
    "benchmark:repository:workflow:confirm": "node ./tools/benchmark/qualify-confirmatory-workflows.mjs",
    "benchmark:repository:prepare:confirm": "node ./tools/benchmark/prepare-confirmatory-study.mjs",
    "benchmark:repository:prepare:supplemental": "node ./tools/benchmark/prepare-supplemental-study.mjs",
    "benchmark:controller:amend": "node ./tools/benchmark/create-controller-amendment.mjs",
    "benchmark:repository:workflow": "node ./tools/benchmark/qualify-repository.mjs --workflow",
    "benchmark:repository:selftest": "node ./tools/benchmark/selftest-repository.mjs",
    "benchmark:corpus:runtime": "node ./tools/benchmark/prepare-corpus-runtime.mjs",
    "benchmark:corpus:qualify": "node ./tools/benchmark/qualify-corpus-repository.mjs",
    "benchmark:prepare": "node ./tools/benchmark/prepare-calibration.mjs",
    "benchmark:run": "node ./tools/benchmark/run-next.mjs",
    "release": "node ./tools/scripts/release.mjs",
    "release:tag": "node ./tools/scripts/tag-release.mjs",
    "tauri": "pnpm --filter @sitecmd/desktop exec tauri",
    "tauri:dev": "node ./tools/scripts/tauri-dev.mjs",
    "tauri:dev:attach": "node ./tools/scripts/tauri-attach.mjs",
    "tauri:build:debug": "pnpm --filter @sitecmd/desktop run tauri:build:debug",
    "tauri:build:release": "pnpm --filter @sitecmd/desktop run tauri:build:release",
    "tauri:build:contributor": "pnpm --filter @sitecmd/desktop run tauri:build:contributor",
    "sitecmd": "node ./tools/scripts/sitecmd.mjs",
    "test": "pnpm run test:desktop && pnpm run test:mcp && pnpm run guardrails:repo:test",
    "test:desktop": "pnpm --filter @sitecmd/desktop run test",
    "typecheck": "pnpm --filter @sitecmd/desktop exec tsc -b && pnpm --filter sitecmd-mcp run typecheck",
    "test:mcp": "pnpm --filter sitecmd-mcp run test",
    "verify:push": "node ./tools/scripts/verify-push.mjs",
    "verify:push:all": "node ./tools/scripts/verify-push.mjs --no-bail",
    "test:ci": "pnpm --filter @sitecmd/desktop run test:ci",
    "test:push": "pnpm --filter @sitecmd/desktop run test:push",
    "test:watch": "pnpm --filter @sitecmd/desktop run test:watch",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "knip:files": "knip --include files,dependencies,devDependencies,binaries,duplicates,unlisted",
    "knip:exports-budget": "node ./tools/scripts/check-knip-export-budget.mjs",
    "quality:mcp": "pnpm --filter sitecmd-mcp run lint && pnpm --filter sitecmd-mcp run typecheck && pnpm --filter sitecmd-mcp run test",
    "size": "pnpm --filter @sitecmd/desktop run size",
    "size:why": "pnpm --filter @sitecmd/desktop run size:why",
    "audit:deps:js": "pnpm audit --prod",
    "audit:licenses:js": "node ./tools/scripts/check-javascript-licenses.mjs",
    "audit:deps:signer": "npm --prefix .github/updater-signer audit --package-lock-only --audit-level=low",
    "audit:deps:rust": "node ./tools/scripts/audit-rust-deps.mjs",
    "audit:deps:rust-policy": "cargo deny --manifest-path apps/desktop/src-tauri/Cargo.toml check advisories bans licenses sources",
    "audit:deps": "pnpm run audit:deps:js && pnpm run audit:licenses:js && pnpm run audit:deps:signer && pnpm run audit:deps:rust && pnpm run audit:deps:rust-policy",
    "audit:codeql": "node ./tools/scripts/audit/check-codeql.mjs",
    "audit:regex": "node ./tools/scripts/audit-regex.mjs",
    "installer:check": "sh -n install.sh && bash -n .github/actions/setup-sitecmd/install.sh && vitest run tools/scripts/installers.test.mjs",
    "workflows:check": "node ./tools/scripts/check-workflows.mjs",
    "guardrails:publication": "node ./tools/scripts/check-publication-hygiene.mjs",
    "guardrails:publication:history": "node ./tools/scripts/check-publication-history.mjs",
    "labels:check": "node ./tools/scripts/check-repository-labels.mjs",
    "labels:check:live": "node ./tools/scripts/check-repository-labels.mjs --live",
    "protection:check": "node ./tools/scripts/check-repository-protection.mjs",
    "protection:check:live": "node ./tools/scripts/check-repository-protection.mjs --live",
    "publication:prepare": "node ./tools/scripts/prepare-public-history.mjs",
    "guardrails:repo": "node ./tools/scripts/check-repo-guardrails.mjs && pnpm run labels:check && pnpm run protection:check && pnpm run guardrails:publication",
    "guardrails:repo:test": "vitest run tools/scripts && node --test tools/benchmark/lib/*.test.mjs",
    "e2e": "pnpm --filter @sitecmd/desktop run e2e",
    "e2e:ui": "pnpm --filter @sitecmd/desktop run e2e:ui",
    "e2e:debug": "pnpm --filter @sitecmd/desktop run e2e:debug",
    "cov:rust": "pnpm --filter @sitecmd/desktop run cov:rust",
    "cov:rust:html": "pnpm --filter @sitecmd/desktop run cov:rust:html",
    "cov:rust:lcov": "pnpm --filter @sitecmd/desktop run cov:rust:lcov",
    "prepare": "lefthook install",
    "facts:generate": "node tools/scripts/generate-product-facts.mjs",
    "legal:generate": "node tools/scripts/generate-third-party-artifacts.mjs",
    "legal:check": "node tools/scripts/generate-third-party-artifacts.mjs --check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-check-file": "^3.3.2",
    "eslint-plugin-react-compiler": "19.1.0-rc.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.12.0",
    "knip": "^6.34.0",
    "lefthook": "^2.1.12",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "safe-regex": "^2.1.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11"
  }
}
